{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "KAFKA_*",
        "S3_*",
        "SMTP_*",
        "JWT_*",
        "API_PUBLIC_URL",
        "REFRESH_TOKEN_PEPPER",
        "LOGIN_EMAIL_HMAC_KEY",
        "EMAIL_TOKEN_SECRET",
        "CLIENT_*_SECRET_HASH",
        "NODE_ENV"
      ]
    }
  }
}
