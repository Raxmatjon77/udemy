{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@udemy/web-admin#build": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@udemy/web-instructor#build": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@udemy/web-student#build": {
      "dependsOn": ["^build", "typecheck"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "cache": false,
      "dependsOn": [
        "@udemy/api#build",
        "@udemy/worker#build",
        "@udemy/transcoder#build",
        "@udemy/stripe-emulator#build",
        "@udemy/web-student#build",
        "@udemy/web-instructor#build",
        "@udemy/web-admin#build"
      ],
      "passThroughEnv": ["E2E_*", "CI", "HOME", "PLAYWRIGHT_*", "DOCKER_*"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "KAFKA_*",
        "S3_*",
        "MEDIA_*",
        "CATALOG_*",
        "PAYMENTS_*",
        "STRIPE_*",
        "COMMERCE_*",
        "ENROLLMENT_*",
        "LEARNING_*",
        "ENGAGEMENT_*",
        "REALTIME_*",
        "TRANSCODER_*",
        "SMTP_*",
        "JWT_*",
        "API_PUBLIC_URL",
        "REFRESH_TOKEN_PEPPER",
        "LOGIN_EMAIL_HMAC_KEY",
        "EMAIL_TOKEN_SECRET",
        "NOTIFICATIONS_UNSUBSCRIBE_SECRET",
        "CLIENT_*_SECRET_HASH",
        "NODE_ENV",
        "IT_*",
        "CI"
      ]
    }
  }
}
