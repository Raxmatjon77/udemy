# Copy to .env for local dev. Values match infra/docker/docker-compose.dev.yml.
# Read by apps/api and apps/worker (cwd = apps/<name>, they fall back to ../../.env) and by the
# @udemy/db migration CLI. The Next apps have their own apps/web-*/.env.example.
#
# Lines marked [PROD: override] hold dev-only placeholder values. In staging/prod every one of them
# MUST come from the secret store (k8s Secret / CI secret), never from this file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

DATABASE_URL=postgres://udemy:udemy@localhost:5432/udemy

KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=udemy-worker
# Optional worker tuning (defaults shown): -1 = broker default for auto-created handler topics.
# Business topics (identity.user, users.instructor_application, access.user_role, catalog.course,
# media.asset, commerce.order, commerce.course_price, commerce.coupon, enrollment.enrollment,
# system.ping, plus their DLQs) are pre-created by the kafka-init service
# (infra/kafka/create-topics.sh), with explicit retention where the design asks for it.
# KAFKA_TOPIC_PARTITIONS=-1
# KAFKA_TOPIC_REPLICATION_FACTOR=-1
# KAFKA_METADATA_MAX_AGE_MS=30000
# Identity cleanup job in the worker (defaults shown). Deletes expired tokens/sessions and
# security_events older than 180 days, in batches, guarded by a Postgres advisory lock.
# IDENTITY_CLEANUP_ENABLED=true
# IDENTITY_CLEANUP_INTERVAL_MS=3600000
# IDENTITY_CLEANUP_INITIAL_DELAY_MS=60000
# IDENTITY_CLEANUP_GRACE_DAYS=7
# IDENTITY_CLEANUP_TOKEN_BATCH_SIZE=5000
# IDENTITY_CLEANUP_SESSION_BATCH_SIZE=500
# IDENTITY_CLEANUP_SECURITY_EVENT_BATCH_SIZE=5000
# IDENTITY_CLEANUP_MAX_BATCHES_PER_RUN=200
# Media cleanup job in the worker (design §5 MediaCleanupJob A-D), guarded by advisory lock
# 0x75646d79_02. Uses the S3_* settings below (delete, list multipart, abort).
MEDIA_CLEANUP_ENABLED=true
# Run every N ms (default 3600000 = 1 h); first run N ms after boot (default 120000).
MEDIA_CLEANUP_INTERVAL_MS=3600000
MEDIA_CLEANUP_INITIAL_DELAY_MS=120000
# Rows per batch transaction (default 100) and batches per run per step (default 50). Small
# batches: every purged asset also deletes its objects in MinIO.
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_CLEANUP_MAX_BATCHES_PER_RUN=50
# A. UPLOADING assets older than this become ABORTED and their multipart upload is aborted.
#    Default 24.
MEDIA_UPLOAD_TTL_HOURS=24
# C. Purge grace for assets with no usages: never attached (default 24 h) / released (default 7 d).
MEDIA_UNATTACHED_GRACE_HOURS=24
MEDIA_UNUSED_GRACE_DAYS=7
# D. Delete the uploaded original this many days after READY (decision Q5). Default 7. Dev: 1.
#    Originals are not kept for re-transcoding; raise it before prod if that changes.
MEDIA_SOURCE_RETENTION_DAYS=7
# Outbox retention job in the worker (Phase 3, defaults shown), guarded by advisory lock
# 0x75646d79_10. Deletes outbox.events rows older than OUTBOX_EVENTS_RETENTION_HOURS that the
# replication slot OUTBOX_REPLICATION_SLOT has confirmed (never unconfirmed ones), and
# outbox.processed_events rows older than PROCESSED_EVENTS_RETENTION_DAYS (min 8: must outlive the
# retention of every consumed topic, 7 days here). Also read by the DLQ CLI (dlq:replay skips
# DLQ messages older than PROCESSED_EVENTS_RETENTION_DAYS unless --allow-stale).
# OUTBOX_RETENTION_ENABLED=true
# OUTBOX_RETENTION_INTERVAL_MS=3600000
# OUTBOX_RETENTION_INITIAL_DELAY_MS=180000
# OUTBOX_EVENTS_RETENTION_HOURS=72
# PROCESSED_EVENTS_RETENTION_DAYS=30
# OUTBOX_RETENTION_BATCH_SIZE=5000
# OUTBOX_RETENTION_MAX_BATCHES_PER_RUN=100
# OUTBOX_REPLICATION_SLOT=udemy_outbox
# Pipeline health in the worker's /health/ready ("pipeline" detail, informational: degraded, never
# 503). KAFKA_CONNECT_URL is optional; unset = connector check skipped. Dev: http://localhost:8083.
# KAFKA_CONNECT_URL=http://localhost:8083
# DEBEZIUM_CONNECTOR_NAME=udemy-outbox
# Consumer lag log (committed offset vs high watermark per handled topic), every N ms; 0 = off.
# PIPELINE_METRICS_INTERVAL_MS=60000

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_UPLOADS=udemy-uploads
S3_BUCKET_MEDIA=udemy-media
# Endpoint used to SIGN the URLs that browsers call directly (upload part PUTs, HLS segments,
# images, downloads); S3_ENDPOINT stays the server-to-server address. Dev uses 127.0.0.1, a
# different site from `localhost`, so the apps' cookies are never sent to MinIO (design §9).
# [PROD: override] with the public media host, e.g. https://media.udemy.example
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# Path-style URLs (http://host/bucket/key). Required by MinIO; set false only for a provider that
# needs virtual-hosted style (AWS S3 bucket subdomains). Default: true.
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------ API: media (design §4, §9)
# TTL of each presigned upload-part PUT URL, seconds. Default 900 (15 min).
MEDIA_PART_URL_TTL_S=900
# TTL of the presigned HLS segment GETs written into rendition playlists, seconds. The player
# re-fetches the playlist on a 403. Default 3600 (1 h, decision Q8).
MEDIA_PLAYBACK_URL_TTL_S=3600
# TTL of presigned thumbnail / poster GETs (served through a redirect route with max-age=300).
# Default 3600.
MEDIA_IMAGE_URL_TTL_S=3600
# TTL of presigned lecture-resource downloads (attachment + octet-stream). Default 300.
MEDIA_DOWNLOAD_URL_TTL_S=300
# Max declared size per purpose, bytes.
#   LECTURE_VIDEO    default 4294967296 (4 GiB). Dev: 1073741824 (1 GiB) keeps MinIO small.
#   COURSE_THUMBNAIL default 5242880 (5 MiB; the transcoder also caps decode at 40 MP)
#   LECTURE_RESOURCE default 104857600 (100 MiB)
MEDIA_MAX_VIDEO_BYTES=4294967296
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_RESOURCE_BYTES=104857600
# Storage quota per owner: sum of declared sizes of non-purged UPLOADING/UPLOADED/PROCESSING/READY
# assets. Default 107374182400 (100 GiB). [PROD: override] with the product limit (the design leaves
# the number open; confirm before launch). Dev: 10737418240 (10 GiB).
MEDIA_QUOTA_BYTES_PER_OWNER=107374182400
# Max assets one owner may have in UPLOADING at once. Default 5.
MEDIA_MAX_CONCURRENT_UPLOADS=5

# ------------------------------------------------------------------ API: catalog (design §13 Q6)
# Submit-for-review thresholds: at least N lectures and N seconds of READY video in the working
# copy. Defaults 5 and 1800 (30 min, Udemy-like). Dev and e2e: 1 and 0.
CATALOG_SUBMIT_MIN_LECTURES=5
CATALOG_SUBMIT_MIN_VIDEO_SECONDS=1800

# ------------------------------------------------------------------ API: payments (Phase 4 D9, D12, §9)
# API only: the worker never holds a Stripe key (D9). Phase 4 is test mode only; the env schema
# refuses sk_live_/rk_live_ keys. REAL Stripe test keys go only in your untracked .env, never here.
# Provider adapter. Only `stripe` exists (the real StripePaymentProvider in @udemy/payments).
PAYMENTS_PROVIDER=stripe
# Dev: throwaway values that apps/stripe-emulator accepts (compose passes the same values to it).
# Real Stripe: an `sk_test_...` key, or better a restricted `rk_test_...` key with write access to
# Checkout Sessions and Refunds only.
# [PROD: override] from the secret store.
STRIPE_SECRET_KEY=sk_test_emulator_dev
# Signing secret of the webhook endpoint POST /api/v1/webhooks/stripe. Dev: the emulator signs its
# deliveries with this value. With `stripe listen` use the secret it prints (`--print-secret`, see
# infra/docker/README.md). CI generates a random one per run.
# [PROD: override] with the endpoint's whsec_ secret from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_dev_emulator_change_me_0000000000000000
# Base URL of the Stripe API. Dev: the emulator on 12111 (compose `--profile emulator`, or
# `pnpm dev` in apps/stripe-emulator). Remove the line to talk to the real api.stripe.com.
# [PROD: override] remove it (real Stripe).
STRIPE_API_BASE_URL=http://127.0.0.1:12111
# Stripe API version sent with every request. Default: the version pinned in @udemy/payments; set
# it only to try a newer version before bumping the pin.
# STRIPE_API_VERSION=
# Max age of a webhook signature timestamp, seconds (checked against the server clock). Default 300.
STRIPE_WEBHOOK_TOLERANCE_S=300
# Checkout success/cancel URLs are built from STUDENT_APP_ORIGIN (set in the Mail section below,
# shared with the worker).

# ------------------------------------------------------------------ API: commerce (Phase 4 §13)
# Single platform currency in Phase 4 (Q4). Default USD.
COMMERCE_CURRENCY=USD
# Days after payment in which a student may request a refund (Q3). Default 30.
COMMERCE_REFUND_WINDOW_DAYS=30
# Instructor share of the net paid amount, basis points (Q2: flat 70%). Snapshotted per order line.
COMMERCE_INSTRUCTOR_SHARE_BPS=7000
# Lifetime of a Stripe Checkout Session, minutes. Stripe accepts 30 to 1440. Default 30.
COMMERCE_CHECKOUT_SESSION_TTL_MIN=30
# Max courses in one cart. Default 20.
COMMERCE_CART_MAX_ITEMS=20
# CommerceJobs in the API (refund dispatcher + reconciler, advisory lock 0x75646d79_03). Default true.
# Disable it on API replicas that should not run jobs (the advisory lock already makes one run win).
COMMERCE_JOBS_ENABLED=true
# Refund dispatcher poll, ms. Default 60000. Approved refunds also get an immediate post-commit kick,
# so the poll only catches what a crash or a provider error left behind.
COMMERCE_REFUND_DISPATCH_INTERVAL_MS=60000
# Reconciler (stale CREATING payments, OPEN sessions past expiry), ms. Default 300000 (5 min).
COMMERCE_RECONCILE_INTERVAL_MS=300000

# ------------------------------------------------------------------ Worker: enrollment (Phase 4 §7)
# Mail the instructor on every new enrollment (enrollment.instructor-new-enrollment-mailer).
# Default false.
ENROLLMENT_INSTRUCTOR_MAIL_ENABLED=false

SMTP_HOST=localhost
SMTP_PORT=1025

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ------------------------------------------------------------------ API: JWT (design §9)
# Public base URL of the API; used as the JWT `iss` claim. The BFFs' JWT_ISSUER must equal it.
API_PUBLIC_URL=http://localhost:4000
# JWT `aud` claim. The BFFs' JWT_AUDIENCE must equal it.
JWT_AUDIENCE=udemy-api
# Directory of Ed25519 signing keys, one `<kid>.pem` (PKCS8) per key; relative to apps/api.
# Dev: `pnpm --filter @udemy/api keys:generate` writes here (.secrets/ is gitignored).
# Prod: mounted from a k8s Secret.
JWT_KEYS_DIR=./.secrets/jwt
# kid of the key used for signing; must match a file `<JWT_ACTIVE_KID>.pem` in JWT_KEYS_DIR.
# Format: ed25519-YYYY-MM. Rotation procedure: design §9 "Key management".
JWT_ACTIVE_KID=ed25519-2026-10

# ------------------------------------------------------------------ API: secrets
# Generate real values with: openssl rand -base64 32
# [PROD: override] HMAC pepper for refresh-token hashes. Rotating it invalidates every refresh
# token, i.e. LOGS EVERYONE OUT. Rotate only deliberately.
REFRESH_TOKEN_PEPPER=dev-refresh-token-pepper-change-me-in-prod-0000
# [PROD: override] HMAC key for login rate-limit keys and identity.security_events.email_hash.
# Rotating it resets rate-limit counters and breaks correlation with older security_events rows.
LOGIN_EMAIL_HMAC_KEY=dev-login-email-hmac-key-change-me-in-prod-0000

# ------------------------------------------------------------------ API: BFF client credentials
# Each Next BFF authenticates to the API with X-Client-Id + secret. The API stores only the
# lowercase hex SHA-256 of each secret; the plain secret lives in apps/web-*/.env as API_CLIENT_SECRET.
# Compute a hash (no trailing newline!):
#   printf '%s' "$SECRET" | openssl dgst -sha256 -r | cut -d' ' -f1
# The dev hashes below match the placeholder secrets in apps/web-*/.env.example:
#   student-bff     dev-student-bff-secret-change-me-in-prod
#   instructor-bff  dev-instructor-bff-secret-change-me-in-prod
#   admin-bff       dev-admin-bff-secret-change-me-in-prod
# [PROD: override] all three (generate secrets with: openssl rand -base64 32).
CLIENT_STUDENT_SECRET_HASH=a53f56679c9a171d127e55ee0d0a5b4a37c713317c0c21a6144f26c4044ec441
CLIENT_INSTRUCTOR_SECRET_HASH=3b7bb27be45a70680b0543f97491aa95dc64d9833e963bb31915d2510021d86a
CLIENT_ADMIN_SECRET_HASH=139b0f73465c6df0c15b5b6b0d73e462984e5312bfb71020049aca12efd3cb82

# ------------------------------------------------------------------ Worker only
# [PROD: override] Key for the deterministic one-time email tokens (verify email / reset password).
# Give it to the worker only; the API never needs it. Rotating it invalidates outstanding links.
EMAIL_TOKEN_SECRET=dev-email-token-secret-change-me-in-prod-0000

# ------------------------------------------------------------------ Mail (worker)
MAIL_FROM="Udemy Clone <no-reply@udemy.local>"
# App origins used to build links in emails (e.g. ${STUDENT_APP_ORIGIN}/verify-email#token=...).
# The API also uses STUDENT_APP_ORIGIN for the Stripe Checkout success and cancel URLs (Phase 4).
# [PROD: override] with the public https origins.
STUDENT_APP_ORIGIN=http://localhost:3000
INSTRUCTOR_APP_ORIGIN=http://localhost:3001
ADMIN_APP_ORIGIN=http://localhost:3002

# ------------------------------------------------------------------ Transcoder (apps/transcoder)
# Leases media.transcode_jobs and runs ffprobe/ffmpeg (design D5, §5 RunTranscodeJob). Uses
# DATABASE_URL and the S3_* settings above (GET/DELETE on uploads, PUT on media).
# Dev runs it on the host (needs ffmpeg/ffprobe >= 6 on PATH; `brew install ffmpeg` on macOS), or
# in Docker: `--profile transcoder` in infra/docker/docker-compose.dev.yml (pinned ffmpeg 8.1).
# Binaries: a bare name is resolved through PATH. The image sets /usr/bin/ffmpeg, /usr/bin/ffprobe.
TRANSCODER_FFMPEG_PATH=ffmpeg
TRANSCODER_FFPROBE_PATH=ffprobe
# Jobs run in parallel by one process. Default 1 (scale with replicas, not with this).
TRANSCODER_CONCURRENCY=1
# Fallback poll when no LISTEN media_transcode notification arrives, ms. Default 5000.
TRANSCODER_POLL_INTERVAL_MS=5000
# Lease length; the job heartbeats every 30 s and another transcoder may take the job over once
# the lease expires (counted as an attempt). Default 120000 (2 min).
TRANSCODER_LEASE_MS=120000
# ffmpeg -threads. Default 0 (ffmpeg picks, i.e. all cores). [PROD: override] with the pod's CPU
# limit. The compose service uses 1 (2 GB Docker VM).
TRANSCODER_THREADS=0
# Highest rendition of the ladder (360/720/1080; never above the source). Default 1080. Dev: 720.
TRANSCODER_MAX_HEIGHT=1080
# Wall-clock limit per job = max(300 s, source duration x factor); also killed after 120 s
# without progress. Default 4.
TRANSCODER_TIMEOUT_FACTOR=4
# Sources longer than this fail as TOO_LONG (poison, no retry). Default 14400 (4 h).
TRANSCODER_MAX_SOURCE_SECONDS=14400
# Attempts per job before it fails for good (written to media.transcode_jobs.max_attempts). Default 3.
TRANSCODER_MAX_ATTEMPTS=3
# Scratch dir for the source download and outputs (needs free space >= 3x the source size).
# Created if missing, wiped per job. Default /tmp/udemy-transcoder (image: /tmp/transcoder).
TRANSCODER_TMP_DIR=/tmp/udemy-transcoder
# Health port (/health/live, /health/ready). api 4000, worker 4001, transcoder 4002.
TRANSCODER_HEALTH_PORT=4002
# Generate the seek-preview sprite (1 frame / 10 s, 10x10 tiles + WebVTT). Default true.
TRANSCODER_SPRITES_ENABLED=true

# Host ports for the dev stack (docker compose reads these via --env-file .env).
# Change them if Postgres/Redis already run natively, and update DATABASE_URL/REDIS_URL to match.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Origins MinIO answers CORS for (server-wide; compose default: the three web apps on 3000-3002).
# Set it when the web apps run on other ports, then recreate minio.
# MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
