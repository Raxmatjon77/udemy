    "@udemy/eslint-config": "workspace:*",
    "@udemy/tsconfig": "workspace:*",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "typescript": "~6.0.3"
  }
}
