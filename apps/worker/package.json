{
  "name": "@udemy/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Kafka consumers (outbox events from Debezium) with idempotency, retries and a DLQ.",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "cli": "node dist/cli/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@socket.io/redis-emitter": "5.1.0",
    "@udemy/contracts": "workspace:*",
    "@udemy/db": "workspace:*",
    "@udemy/markdown": "workspace:*",
    "@udemy/nest-common": "workspace:*",
    "@udemy/storage": "workspace:*",
    "dejavu-fonts-ttf": "2.37.3",
    "ioredis": "6.0.0",
    "pdfkit": "0.17.2",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@udemy/eslint-config": "workspace:*",
    "@udemy/tsconfig": "workspace:*",
    "eslint": "10.12.0",
    "kysely": "0.29.6",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
