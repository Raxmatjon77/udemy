{
  "name": "@udemy/transcoder",
  "version": "0.0.0",
  "private": true,
  "description": "Leases media.transcode_jobs and runs ffprobe/ffmpeg on uploaded media (HLS ladder, posters, sprites, thumbnails, resources).",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/terminus": "12.1.0",
    "@udemy/contracts": "workspace:*",
    "@udemy/db": "workspace:*",
    "@udemy/nest-common": "workspace:*",
    "@udemy/storage": "workspace:*",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@udemy/eslint-config": "workspace:*",
    "@udemy/tsconfig": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
