# Server-only settings for the web-admin BFF (design §10). Copy to apps/web-admin/.env.local.
# None of these are NEXT_PUBLIC_*: the browser never talks to the API directly, every call goes
# through this app's /api/auth/* and /api/proxy/* route handlers.

# Base URL of the NestJS API as reached from this Next server (no /api/v1 suffix; the proxy adds it).
# Prod: the in-cluster service URL, e.g. http://udemy-api.<namespace>.svc:4000
API_INTERNAL_URL=http://localhost:4000
# Client credentials sent to the API as X-Client-Id / secret. The API checks the secret against
# CLIENT_ADMIN_SECRET_HASH in the root .env (SHA-256, see the root .env.example).
API_CLIENT_ID=admin-bff
# [PROD: override] dev placeholder; its hash is already in the root .env.example.
API_CLIENT_SECRET=dev-admin-bff-secret-change-me-in-prod
# This app's own public origin. Unsafe requests must carry Origin === APP_ORIGIN (CSRF check).
APP_ORIGIN=http://localhost:3002

# Access-token verification in proxy.ts. Must match the API's API_PUBLIC_URL and JWT_AUDIENCE.
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=udemy-api
JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Auth cookies use the __Host- prefix and the Secure flag. Keep true: Chrome and Firefox accept
# Secure cookies on http://localhost. Safari does not; for Safari on plain-http localhost set
# false (drops __Host- and Secure). Dev only: the app refuses to boot with false in production.
COOKIE_SECURE=true
