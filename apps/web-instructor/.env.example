# Server-only settings for the web-instructor BFF (design §10). Copy to apps/web-instructor/.env.local.
# None of these are NEXT_PUBLIC_*: the browser never talks to the API directly, every call goes
# through this app's /api/auth/* and /api/proxy/* route handlers.

# Base URL of the NestJS API as reached from this Next server (no /api/v1 suffix; the proxy adds it).
# Prod: the in-cluster service URL, e.g. http://udemy-api.<namespace>.svc:4000
API_INTERNAL_URL=http://localhost:4000
# Client credentials sent to the API as X-Client-Id / secret. The API checks the secret against
# CLIENT_INSTRUCTOR_SECRET_HASH in the root .env (SHA-256, see the root .env.example).
API_CLIENT_ID=instructor-bff
# [PROD: override] dev placeholder; its hash is already in the root .env.example.
API_CLIENT_SECRET=dev-instructor-bff-secret-change-me-in-prod
# This app's own public origin. Unsafe requests must carry Origin === APP_ORIGIN (CSRF check).
APP_ORIGIN=http://localhost:3001

# Access-token verification in proxy.ts. Must match the API's API_PUBLIC_URL and JWT_AUDIENCE.
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=udemy-api
JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Auth cookies use the __Host- prefix and the Secure flag. Keep true: Chrome and Firefox accept
# Secure cookies on http://localhost. Safari does not; for Safari on plain-http localhost set
# false (drops __Host- and Secure). Dev only: the app refuses to boot with false in production.
COOKIE_SECURE=true

# Public origin of the student app. /not-instructor and the login page link to its
# /become-instructor page. Prod: e.g. https://www.udemy.example
STUDENT_APP_ORIGIN=http://localhost:3000

# Public origin (scheme://host[:port], no path) of the media storage the browser talks to directly:
# HLS segments, thumbnails/posters and, in the instructor app, upload part PUTs. Added to the CSP
# connect-src and img-src (design §9). Must equal the origin of the API's S3_PUBLIC_ENDPOINT.
# Dev: 127.0.0.1, a different site from localhost, so this app's cookies never reach MinIO.
# [PROD: override] with the media host, e.g. https://media.udemy.example
MEDIA_PUBLIC_ORIGIN=http://127.0.0.1:9000

# Origin (scheme://host[:port], no path) of the API's socket.io endpoint (Phase 5: notification bell
# and live hints; WebSocket transport, path /realtime/socket.io). Added to the CSP connect-src as
# ws:// (or wss:// for https). Must equal the API's REALTIME_PUBLIC_URL in the root .env.
# Optional: unset, the browser may not open the socket and the app falls back to polling.
# [PROD: override] with the public API host, e.g. https://api.udemy.example
REALTIME_PUBLIC_URL=http://localhost:4000
