{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": false },
  // src/testing (fixtures + MSW handlers) IS built, as ESM (.mts -> dist/testing/*.mjs), for the
  // `@udemy/contracts/testing` subpath. The main entry (src/index.ts) never imports it.
  "exclude": ["dist", "node_modules", "**/*.spec.ts", "**/*.spec.mts", "**/*.test.ts"]
}
