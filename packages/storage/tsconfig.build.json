{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": false },
  // src/testing (the vitest integration harness) IS built, as ESM (.mts -> dist/testing/*.mjs),
  // for the `@udemy/storage/testing` subpath. The main entry (src/index.ts) never imports it.
  "exclude": ["dist", "node_modules", "**/*.spec.ts", "**/*.test.ts"]
}
