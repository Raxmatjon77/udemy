{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": false },
  // src/testing IS built for the `@udemy/db/testing` subpath (index.mts -> dist/testing/index.mjs,
  // ESM because it imports vitest). The main entry (src/index.ts) never imports it.
  "exclude": ["dist", "node_modules", "**/*.spec.ts", "**/*.test.ts"]
}
